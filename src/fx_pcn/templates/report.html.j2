{% extends "base.html.j2" %}

{% block head %}
<title>FX Partial-Correlation Network Report — {{ report_date }}</title>
<style>
  .front-matter {
    background: #f0f4ff;
    border-left: 4px solid #2a78d6;
    border-radius: 4px;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0 2rem;
  }
  .front-matter h2 { margin-top: 0; font-size: 1.1rem; color: #17439c; }
  .params { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; margin: .5rem 0 0; padding: 0; list-style: none; }
  .params li { font-size: .9rem; }
  .params .label { color: #6f6e6a; margin-right: .3rem; }
  .plot-pair { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; }
  .plot-pair figure { flex: 1 1 260px; }
  .summary { background: #f9f9f9; border: 1px solid #e8e8e8; border-radius: 4px; padding: 1rem 1.25rem; }
</style>
{% endblock %}

{% block body %}
<h1>FX Partial-Correlation Network Report</h1>
<p class="meta">Generated: {{ updated }}</p>

<div class="front-matter">
  <h2>Report date: {{ report_date }}</h2>
  <p class="meta">Data reflects the most recent date present in the source tables.</p>
  <ul class="params">
    <li><span class="label">Window days:</span>{{ params.window_days }}</li>
    <li><span class="label">Step days:</span>{{ params.step_days }}</li>
    <li><span class="label">Min observations:</span>{{ params.min_observations }}</li>
    <li><span class="label">Max lag:</span>{{ params.max_lag }}</li>
    <li><span class="label">FDR alpha:</span>{{ params.fdr_alpha }}</li>
    <li><span class="label">Granularity:</span>{{ params.granularity }}</li>
  </ul>
</div>

<section id="network-graph">
  <h2>Network graph — {{ report_date }}</h2>
  <figure>
    <img src="{{ network_graph_data_uri }}" alt="FX partial-correlation network graph for {{ report_date }}">
  </figure>
</section>

<section id="recent-data">
  <h2>Most recent data</h2>
  {% if recent_density_rows %}
  <table>
    <thead>
      <tr>
        <th>Date</th>
        <th>Edge count</th>
        <th>Density</th>
        <th>Mean |partial corr|</th>
        <th>Directed</th>
        <th>Bidirected</th>
        <th>Undirected</th>
      </tr>
    </thead>
    <tbody>
      {% for row in recent_density_rows %}
      <tr>
        <td>{{ row.date }}</td>
        <td>{{ row.edge_count }}</td>
        <td>{{ '%.4f' | format(row.density) }}</td>
        <td>{{ '%.4f' | format(row.mean_abs_partial_corr) }}</td>
        <td>{{ row.directed_edge_count }}</td>
        <td>{{ row.bidirected_edge_count }}</td>
        <td>{{ row.undirected_edge_count }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p class="no-data">No density data available.</p>
  {% endif %}
</section>

<section id="recent-direction-changes">
  <h2>Most recent direction changes</h2>
  {% if recent_flip_rows %}
  <table>
    <thead>
      <tr>
        <th>Date</th>
        <th>Pair i</th>
        <th>Pair j</th>
        <th>Previous direction</th>
        <th>New direction</th>
      </tr>
    </thead>
    <tbody>
      {% for row in recent_flip_rows %}
      <tr>
        <td>{{ row.date }}</td>
        <td>{{ row.pair_i }}</td>
        <td>{{ row.pair_j }}</td>
        <td>{{ row.previous_direction }}</td>
        <td>{{ row.new_direction }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p class="no-data">No direction changes recorded.</p>
  {% endif %}
</section>

<section id="distributions">
  <h2>Distributions — full history</h2>
  <figure>
    <img src="{{ boxplot_data_uri }}" alt="Boxplots of density and mean |partial correlation| across the full time series">
    <figcaption>Density and mean |partial correlation|, across every date in the source data.</figcaption>
  </figure>
</section>

<section id="trends">
  <h2>Trends — last year</h2>
  <figure>
    <img src="{{ timeseries_data_uri }}" alt="Time series of density and mean |partial correlation| over the last year">
    <figcaption>Density and mean |partial correlation|, trailing 365 days from {{ report_date }}.</figcaption>
  </figure>
</section>

<section id="summary">
  <h2>Qualitative summary</h2>
  {% if llm_summary %}
  <div class="summary">
    {% for paragraph in llm_summary.split('\n\n') %}
    <p>{{ paragraph }}</p>
    {% endfor %}
  </div>
  <p class="warn">Generated by an LLM from the tables and statistics above. Apply judgement
    before acting on any interpretation. <strong>Caveat emptor!</strong></p>
  {% elif llm_summary_enabled %}
  <p class="no-data">LLM summary unavailable (the call failed or returned no content) — see logs.</p>
  {% else %}
  <p class="no-data">LLM summary skipped (--no-llm-summary).</p>
  {% endif %}
</section>
{% endblock %}
