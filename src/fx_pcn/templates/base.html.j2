<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {% block head %}{% endblock %}
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      font-size: 1rem;
      line-height: 1.7;
      color: #0b0b0b;
      background: #fcfcfb;
      max-width: 900px;
      margin: 2.5rem auto;
      padding: 0 1.5rem;
    }
    h1 { font-size: 1.6rem; border-bottom: 2px solid #ddd; padding-bottom: .5rem; }
    h2 { font-size: 1.2rem; margin-top: 2.2rem; color: #111; }
    h3 { font-size: 1rem; margin-top: 1.5rem; margin-bottom: .25rem; }
    a { color: #2a78d6; text-decoration: none; }
    a:hover { text-decoration: underline; }
    .meta { color: #6f6e6a; font-size: .9rem; margin-top: .25rem; }
    .warn { color: #b00; font-style: italic; }
    section + section { border-top: 1px solid #e8e8e8; margin-top: 2rem; padding-top: 1.5rem; }
    figure { margin: 1rem 0; text-align: center; }
    figure img { max-width: 100%; height: auto; border: 1px solid #e8e8e8; border-radius: 4px; }
    figcaption { color: #6f6e6a; font-size: .85rem; margin-top: .4rem; }
    table { border-collapse: collapse; width: 100%; margin: 1rem 0; font-size: .9rem; }
    th, td { text-align: left; padding: .4rem .6rem; border-bottom: 1px solid #e8e8e8; }
    th { color: #6f6e6a; font-weight: 600; text-transform: uppercase; font-size: .75rem;
         letter-spacing: .04em; }
    tbody tr:hover { background: #f6f6f5; }
    .no-data { color: #6f6e6a; font-style: italic; }
  </style>
</head>
<body>
  {% block body %}{% endblock %}
</body>
</html>
